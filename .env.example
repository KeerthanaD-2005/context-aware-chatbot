# ==============================================================================
# StudyBuddy Chatbot - Environment Configuration
# ==============================================================================

# Option 1: OpenAI Configuration
# Get an API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Google Gemini Configuration (Free tier available at https://aistudio.google.com/)
# Uncomment and supply your Gemini key if using Google Gemini instead of OpenAI:
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# Optional: Explicitly pick provider ("openai" or "gemini"). Defaults to auto-detect based on key.
# LLM_PROVIDER=openai

# ==============================================================================
# Context Window Management Settings
# ==============================================================================
# Strategy: "sliding_window" (truncates to last N messages) or "summarization" (summarizes older messages)
CONTEXT_STRATEGY=sliding_window

# Maximum messages kept in the active context window (excluding system instructions)
MAX_HISTORY_MESSAGES=10

# Message count threshold before running summarization is triggered (when strategy is "summarization")
SUMMARY_TRIGGER_THRESHOLD=8
